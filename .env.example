# Salin berkas ini menjadi .env.local lalu isi dengan nilai proyekmu.
# Keduanya ada di Supabase Dashboard → Project Settings → API.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Proyek baru memakai istilah "publishable key" untuk kunci yang sama.
# Bila itu yang kamu punya, pakai baris ini sebagai gantinya:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ============================================================
# Misi lencana (opsional)
#
# Tiga nilai di bawah hanya diperlukan untuk misi "ikuti @CEOkomentar di X".
# Tanpa salah satunya, misi itu tetap tampil tetapi tombol verifikasinya
# menjawab "belum diaktifkan" — dan tidak ada lencana yang bisa diberikan.
# Selebihnya aplikasi berjalan seperti biasa.
# ============================================================

# Supabase Dashboard → Project Settings → API → service_role.
#
# JANGAN PERNAH memberi kunci ini awalan NEXT_PUBLIC_ dan jangan menaruhnya di
# berkas yang ikut ke peramban: ia melewati seluruh kebijakan RLS. Di sini ia
# hanya dipakai Route Handler untuk memberi lencana.
SUPABASE_SERVICE_ROLE_KEY=

# X Developer Portal → Projects & Apps → aplikasimu → User authentication settings.
#   * Type of App: Web App (atau Native App bila tanpa client secret)
#   * App permissions: Read
#   * Callback URI: <APP_URL>/api/misi/x/kembali
X_CLIENT_ID=
# Kosongkan bila aplikasimu bertipe public client (PKCE tanpa rahasia).
X_CLIENT_SECRET=

# Alamat pangkal aplikasi, tanpa garis miring di akhir. Harus sama persis
# dengan Callback URI yang didaftarkan di X. Tanpa nilai ini alamatnya disusun
# dari permintaan yang masuk — cukup untuk pengembangan lokal.
APP_URL=http://localhost:3000
