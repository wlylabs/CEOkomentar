# Salin berkas ini menjadi .env.local lalu isi dengan nilai proyekmu.
# Keduanya ada di Supabase Dashboard → Project Settings → API.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Proyek baru memakai istilah "publishable key" untuk kunci yang sama.
# Bila itu yang kamu punya, pakai baris ini sebagai gantinya:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
