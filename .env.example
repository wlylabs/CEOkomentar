# Salin berkas ini menjadi .env.local lalu isi dengan nilai proyekmu.
# Keduanya ada di Supabase Dashboard → Project Settings → API.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Proyek baru memakai istilah "publishable key" untuk kunci yang sama.
# Bila itu yang kamu punya, pakai baris ini sebagai gantinya:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ============================================================
# Lencana (opsional)
#
# Satu nilai di bawah diperlukan agar admin bisa memberi dan mencabut lencana
# lewat kartu profil. Tanpa itu panel lencananya tetap tampil tetapi tombolnya
# menjawab "gagal disimpan", dan tidak ada lencana yang bisa berpindah tangan.
# Selebihnya aplikasi berjalan seperti biasa.
# ============================================================

# Supabase Dashboard → Project Settings → API → service_role.
#
# JANGAN PERNAH memberi kunci ini awalan NEXT_PUBLIC_ dan jangan menaruhnya di
# berkas yang ikut ke peramban: ia melewati seluruh kebijakan RLS. Di sini ia
# hanya dipakai Route Handler untuk menulis ke tabel lencana.
SUPABASE_SERVICE_ROLE_KEY=
